# image2cpp Configuration Example
# Copy this file to .env and adjust values as needed

# Logging Configuration
LOG_LEVEL=DEBUG
LOG_FILE=image2cpp.log

# Crop Settings (pixels to crop from each edge)
CROP_TOP=0
CROP_RIGHT=0
CROP_BOTTOM=0
CROP_LEFT=0

# Image Compression (percentage, 1-100)
COMPRESSION_FACTOR=100

# Server Configuration
FLASK_ENV=development
FLASK_DEBUG=True
